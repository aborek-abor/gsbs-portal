# Copy this file to .env for local development. On Railway, set these as
# Variables in your project settings instead, do not commit a real .env file.

# Automatically provided by Railway once you add a Postgres plugin to this project.
# For local development, point this at a local Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gsbs

# A long, random, secret string used to sign login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep this secret. Anyone who has it can forge admin/member sessions.
JWT_SECRET=

# Railway sets PORT automatically. Only needed for local development.
PORT=3000

# From resend.com, used to send "forgot passcode" reset emails and issued
# certificates. Without this set, those emails are just logged to the server
# console instead of actually being sent (useful for testing).
RESEND_API_KEY=

# Optional. Defaults to Resend's shared sandbox address, which can only
# deliver to the email address you signed up to Resend with. Once you verify
# your own domain in Resend, set this to something like:
# RESEND_FROM_EMAIL="GSBS <admissions@yourdomain.org>"
# (Avoid "no-reply@", some spam filters penalize it.)
RESEND_FROM_EMAIL=

# Optional. The public URL of your live site, used to build links inside
# emails and the Paystack payment callback. If not set, it's inferred from
# the incoming request, which usually works fine on Railway.
APP_URL=

# From paystack.com, used to collect membership dues online (Mobile Money and
# card payments). Without this set, applicants can still apply, but they'll
# see a message that online payment isn't enabled yet, and the Membership
# Admissions Committee can still record payments manually ("Mark as paid")
# for anyone who pays by cash or bank transfer.
# Use your TEST secret key while building/testing (starts with sk_test_),
# switch to your LIVE secret key (starts with sk_live_) only once you're
# ready to accept real payments.
PAYSTACK_SECRET_KEY=
