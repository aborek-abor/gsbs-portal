# Copy this file to .env for local development. On Railway, set these as
# Variables in your project settings instead, do not commit a real .env file.

# Automatically provided by Railway once you add a Postgres plugin to this project.
# For local development, point this at a local Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gsbs

# A long, random, secret string used to sign login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep this secret. Anyone who has it can forge admin/member sessions.
JWT_SECRET=

# Railway sets PORT automatically. Only needed for local development.
PORT=3000

# From resend.com, used to send "forgot passcode" reset emails.
# Without this set, reset requests still work but the email is just logged
# to the server console instead of actually being sent (useful for testing).
RESEND_API_KEY=

# Optional. Defaults to Resend's shared sandbox address, which can only
# deliver to the email address you signed up to Resend with. Once you verify
# your own domain in Resend, set this to something like:
# RESEND_FROM_EMAIL="GSBS <no-reply@yourdomain.org>"
RESEND_FROM_EMAIL=

# Optional. The public URL of your live site, used to build the link inside
# reset emails. If not set, it's inferred from the incoming request, which
# usually works fine on Railway, only set this if reset links come out wrong.
APP_URL=
